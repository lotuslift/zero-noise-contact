{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero-Noise Contact receipt event",
  "type": "object",
  "required": [
    "seq",
    "event",
    "status"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "residuals": {},
    "note": {
      "type": "string"
    },
    "evidence_status": {
      "enum": [
        "USER_SUPPLIED_TRANSCRIPT_ACCOUNT"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "origin_source",
        "type",
        "source_status",
        "status",
        "relations"
      ]
    },
    "claim_id": {
      "type": "string"
    },
    "corrects_seq": {
      "type": "integer",
      "minimum": 1
    },
    "prior_attribution": {
      "type": "string"
    },
    "corrected_attribution": {
      "type": "string"
    }
  }
}
